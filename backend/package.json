{
  "name": "brightloop-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:bun": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:bun": "bun build src/index.ts --target=bun --outdir=dist",
    "start": "node dist/index.js",
    "start:bun": "bun src/index.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:bun": "bun db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:seed:bun": "bun db/seed.ts",
    "db:reset": "tsx db/reset.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src tests db"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@types/node-cron": "^3.0.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.90.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
