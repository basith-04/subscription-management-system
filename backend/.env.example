# Brightloop API — environment variables
# Copy to .env and adjust locally. Never commit real secrets.

APP_ENV=development
HOST=0.0.0.0
PORT=4000

# Comma-separated list of frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL connection.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brightloop
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/brightloop_test

# Session signing secret. At least 32 characters. Required in production.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-please
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=brightloop_session
# true in production; set false only for local HTTP development.
COOKIE_SECURE=false
# Optional host-only cookie domain override.
# COOKIE_DOMAIN=

# Credential rate limiting (defaults: 10 attempts / 15 minutes).
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# SMTP / Mailpit. For local host development, run Mailpit on localhost:1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=no-reply@brightloop.local
# SMTP_USER=
# SMTP_PASS=

# First-admin seed (D-08). Leave unset unless bootstrapping an environment.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe!123
# ADMIN_FULL_NAME=Administrator
# Optional initial staff account; never overwrite existing accounts.
# STAFF_EMAIL=staff@example.com
# STAFF_PASSWORD=ChangeMe!123
# STAFF_FULL_NAME=Staff
