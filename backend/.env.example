# Brightloop API — environment variables
# Copy to .env and adjust locally. Never commit real secrets.

APP_ENV=development
HOST=0.0.0.0
PORT=4000

# Comma-separated list of frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL connection (used once the database layer is implemented).
# DATABASE_URL=postgres://brightloop:brightloop@localhost:5432/brightloop


# Demo auth — TEMPORARY until F01 lands. Remove with F01.
DEMO_AUTH_ENABLED=true