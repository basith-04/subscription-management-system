# Docker Compose overrides (copy to .env for local use)

# Runtime used by both images: node or bun
RUNTIME=node

# Host ports
API_PORT=4000
WEB_PORT=8080
POSTGRES_PORT=5432

# PostgreSQL used by Compose (not the same as DATABASE_URL inside the network)
POSTGRES_DB=brightloop
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=brightloop

# Origin allowed by the API's CORS configuration
ALLOWED_ORIGINS=http://localhost:8080

# Session signing secret, at least 32 characters. Required by Compose.
JWT_SECRET=change-me-to-a-random-value-at-least-32-characters

# Local Compose serves plain HTTP; set true behind HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=brightloop_session
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# Optional first-admin seed, applied by the migrate service (D-08).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe!123
# ADMIN_FULL_NAME=Administrator
