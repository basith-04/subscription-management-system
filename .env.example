# Docker Compose overrides (copy to .env for local use)

# Runtime used by both images: node or bun
RUNTIME=node

# Local HTTP development. Use production only with HTTPS and COOKIE_SECURE=true.
APP_ENV=development

# Host ports
API_PORT=4000
WEB_PORT=8080
POSTGRES_PORT=5432

# PostgreSQL used by Compose. Set a random URL-safe password (letters, digits,
# hyphen, underscore); it is also interpolated into the database URL.
POSTGRES_DB=brightloop
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=

# Origin allowed by the API's CORS configuration
ALLOWED_ORIGINS=http://localhost:8080

# Session signing secret, at least 32 characters. Required by Compose.
JWT_SECRET=

# Local Compose serves plain HTTP; set true behind HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=brightloop_session
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# Optional first-admin seed, applied by the migrate service (D-08).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe!123
# ADMIN_FULL_NAME=Administrator
# STAFF_EMAIL=staff@example.com
# STAFF_PASSWORD=ChangeMe!123
# STAFF_FULL_NAME=Staff
